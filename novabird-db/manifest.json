{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "1.2.5",
  "description": "__MSG_extDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "novabird-db@novabird",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "addressBooks",
    "storage",
    "alarms",
    "clipboardWrite"
  ],
  "experiment_apis": {
    "novabirdDb": {
      "schema": "api/novabirdDb/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "novabirdDb"
          ]
        ],
        "script": "api/novabirdDb/implementation.js"
      }
    },
    "novabirdDbUi": {
      "schema": "api/novabirdDbUi/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "novabirdDbUi"
          ]
        ],
        "script": "api/novabirdDbUi/implementation.js"
      }
    }
  },
  "default_locale": "en",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "options_ui": {
    "page": "options/options.html"
  }
}
