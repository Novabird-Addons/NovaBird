{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "2.0.0",
  "description": "__MSG_extDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "novabird-db@novabird",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "page": "background.html"
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "storage",
    "tabs",
    "menus",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "addressBooks",
    "alarms",
    "clipboardWrite"
  ],
  "optional_permissions": [
    "nativeMessaging",
    "webRequest",
    "webRequestBlocking",
    "http://*/*",
    "https://*/*"
  ],
  "experiment_apis": {
    "searchBar": {
      "schema": "experiments/searchBar/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "searchBar"
          ]
        ],
        "script": "experiments/searchBar/implementation.js"
      }
    },
    "novabirdDb": {
      "schema": "db/api/novabirdDb/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "novabirdDb"
          ]
        ],
        "script": "db/api/novabirdDb/implementation.js"
      }
    },
    "novabirdDbUi": {
      "schema": "db/api/novabirdDbUi/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "novabirdDbUi"
          ]
        ],
        "script": "db/api/novabirdDbUi/implementation.js"
      }
    },
    "searchMigrate": {
      "schema": "experiments/searchMigrate/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "searchMigrate"
          ]
        ],
        "script": "experiments/searchMigrate/implementation.js"
      }
    }
  },
  "default_locale": "en",
  "options_ui": {
    "page": "options/options.html"
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
}
