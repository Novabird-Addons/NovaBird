{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "0.14.6",
  "description": "__MSG_extDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "novabird-conversation@novabird",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "shared/selftest-bg.js",
      "settings.js",
      "conversation.js",
      "background.js"
    ]
  },
  "permissions": [
    "messagesRead",
    "messagesModify",
    "messagesDelete",
    "messagesUpdate",
    "messagesMove",
    "accountsRead",
    "compose",
    "storage"
  ],
  "options_ui": {
    "page": "options/options.html"
  },
  "experiment_apis": {
    "conversationView": {
      "schema": "experiments/conversationView/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "conversationView"
          ]
        ],
        "script": "experiments/conversationView/implementation.js"
      }
    }
  },
  "default_locale": "en",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}